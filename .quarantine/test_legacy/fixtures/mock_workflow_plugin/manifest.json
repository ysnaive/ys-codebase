{
  "name": "mock-workflow-plugin",
  "version": "1.0.0",
  "description": "Mock Workflow Plugin for Interlock System Testing",
  "dependencies": [
    "core >=1.0.0"
  ],
  "contributes": {
    "agents-workflow": {
      "schema_version": "1.0",
      "sop_patches": [
        {
          "target_sop": "NewPlan.md",
          "target_slot": "Phase0",
          "position": "append",
          "content_file": "templates/mock_phase0_rules.md"
        },
        {
          "target_sop": "NewPlan.md",
          "target_slot": "Phase6",
          "position": "prepend",
          "content_file": "templates/mock_phase6_rules.md"
        }
      ],
      "sop_extensions": [
        {
          "name": "mock_interlock_verify",
          "script": "scripts/mock_verify.py",
          "doc": "workflows/extensions/mock_ext.md",
          "trigger": "on_demand"
        }
      ]
    }
  }
}
