{
  "terminal.integrated.enablePersistentSessions": true,
  "files.exclude": {
    "**/.git": true,
    "**/.vscode": true,
    "**/.gitignore": true,
    "**/.gitattributes": true,
    "**/.gitkeep": true,
    "LICENSE": true,
    "**/__pycache__": true,
    "**/.build": true,
    "**/build": true,
    "**/.mirror": true,
    "**/.modules": true,
    "**/modules": true,
    "**/.snapshots": true,
    "**/.venv": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.vscode": true,
    "**/__pycache__": true,
    "**/.cache/**": true,
    "**/.build/**": true,
    "**/build/**": true,
    "**/.mirror/**": true,
    "**/.modules/**": true,
    "**/modules/**": true,
    "**/.snapshots/**": true,
    "**/release/**": true,
    "**/.venv/**": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/__pycache__/**": true,
    "**/.cache/**": true,
    "**/.build/**": true,
    "**/build/**": true,
    "**/.mirror/**": true,
    "**/.modules/**": true,
    "**/modules/**": true,
    "**/.snapshots/**": true,
    "**/release/**": true,
    "plans/archived/**": true,
    "ys_codebase/storage/**": true,
    "**/.venv/**": true
  },
  "git.autorefresh": true,
  "git.autoRepositoryDetection": true,
  "git.decorations.enabled": true,
  "git.experimental.useFsWatcher": false,
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  "markdown.preview.openMarkdownLinks": "inPreview",
  "markdown.preview.doubleClickToSwitchToEditor": true,
  "python.analysis.extraPaths": [
    "./ys_codebase/.venv/current-site-packages",
    "./ys_codebase/source/core",
    "./ys_codebase/source/agents-workflow",
    "./ys_codebase/source/ast",
    "./ys_codebase/source/dev",
    "./ys_codebase/source/file-space",
    "./ys_codebase/source/gdrive-support",
    "./ys_codebase/source/knowledge-db",
    "./ys_codebase/source/server",
    "./ys_codebase/source/vscode-support"
  ],
  "_yscb_managed": {
    "description": "Auto-managed by YSCB vscode-support module. Reversible via 'yscb vscode-support revert' or module uninstall.",
    "extraPaths": [
      "./ys_codebase/.venv/current-site-packages",
      "./ys_codebase/source/core",
      "./ys_codebase/source/agents-workflow",
      "./ys_codebase/source/ast",
      "./ys_codebase/source/dev",
      "./ys_codebase/source/file-space",
      "./ys_codebase/source/gdrive-support",
      "./ys_codebase/source/knowledge-db",
      "./ys_codebase/source/server",
      "./ys_codebase/source/vscode-support"
    ],
    "excludes": {
      "files.watcherExclude": "**/.venv/**",
      "search.exclude": "**/.venv/**",
      "files.exclude": "**/.venv"
    },
    "analysisExclude": [
      "**/.cache/**",
      "**/.snapshots/**",
      "**/.build/**",
      "**/.mirror/**",
      "**/.modules/**",
      "**/.venv/**"
    ],
    "jsonSchemas": [
      "./.vscode/schemas/contributes/agents-workflow.schema.json",
      "./.vscode/schemas/contributes/ast.schema.json",
      "./.vscode/schemas/contributes/core.schema.json",
      "./.vscode/schemas/contributes/dev.schema.json",
      "./.vscode/schemas/contributes/file-space.schema.json",
      "./.vscode/schemas/contributes/gdrive-support.schema.json",
      "./.vscode/schemas/contributes/knowledge-db.schema.json",
      "./.vscode/schemas/contributes/server.schema.json",
      "./.vscode/schemas/contributes/vscode-support.schema.json",
      "./.vscode/schemas/config/agents-workflow.schema.json",
      "./.vscode/schemas/config/core.schema.json",
      "./.vscode/schemas/config/gdrive-support.schema.json",
      "./.vscode/schemas/config/knowledge-db.schema.json",
      "./.vscode/schemas/config/server.schema.json",
      "./.vscode/schemas/meta/format-meta.schema.json",
      "./.vscode/schemas/meta/manifest.schema.json"
    ]
  },
  "python.analysis.exclude": [
    "**/.cache/**",
    "**/.snapshots/**",
    "**/.build/**",
    "**/.mirror/**",
    "**/.modules/**",
    "**/.venv/**"
  ],
  "json.schemas": [
    {
      "fileMatch": [
        "**/contributes/agents-workflow.json",
        "**/config/agents-workflow/contribute.json"
      ],
      "url": "./.vscode/schemas/contributes/agents-workflow.schema.json"
    },
    {
      "fileMatch": [
        "**/contributes/ast.json",
        "**/config/ast/contribute.json"
      ],
      "url": "./.vscode/schemas/contributes/ast.schema.json"
    },
    {
      "fileMatch": [
        "**/contributes/core.json",
        "**/config/core/contribute.json"
      ],
      "url": "./.vscode/schemas/contributes/core.schema.json"
    },
    {
      "fileMatch": [
        "**/contributes/dev.json",
        "**/config/dev/contribute.json"
      ],
      "url": "./.vscode/schemas/contributes/dev.schema.json"
    },
    {
      "fileMatch": [
        "**/contributes/file-space.json",
        "**/config/file-space/contribute.json"
      ],
      "url": "./.vscode/schemas/contributes/file-space.schema.json"
    },
    {
      "fileMatch": [
        "**/contributes/gdrive-support.json",
        "**/config/gdrive-support/contribute.json"
      ],
      "url": "./.vscode/schemas/contributes/gdrive-support.schema.json"
    },
    {
      "fileMatch": [
        "**/contributes/knowledge-db.json",
        "**/config/knowledge-db/contribute.json"
      ],
      "url": "./.vscode/schemas/contributes/knowledge-db.schema.json"
    },
    {
      "fileMatch": [
        "**/contributes/server.json",
        "**/config/server/contribute.json"
      ],
      "url": "./.vscode/schemas/contributes/server.schema.json"
    },
    {
      "fileMatch": [
        "**/contributes/vscode-support.json",
        "**/config/vscode-support/contribute.json"
      ],
      "url": "./.vscode/schemas/contributes/vscode-support.schema.json"
    },
    {
      "fileMatch": [
        "**/config/agents-workflow/config.*.json",
        "**/source/agents-workflow/configurable/config.*.json",
        "**/agents-workflow/configurable/config.*.json"
      ],
      "url": "./.vscode/schemas/config/agents-workflow.schema.json"
    },
    {
      "fileMatch": [
        "**/config/core/config.*.json",
        "**/source/core/configurable/config.*.json",
        "**/core/configurable/config.*.json"
      ],
      "url": "./.vscode/schemas/config/core.schema.json"
    },
    {
      "fileMatch": [
        "**/config/gdrive-support/config.*.json",
        "**/source/gdrive-support/configurable/config.*.json",
        "**/gdrive-support/configurable/config.*.json"
      ],
      "url": "./.vscode/schemas/config/gdrive-support.schema.json"
    },
    {
      "fileMatch": [
        "**/config/knowledge-db/config.*.json",
        "**/source/knowledge-db/configurable/config.*.json",
        "**/knowledge-db/configurable/config.*.json"
      ],
      "url": "./.vscode/schemas/config/knowledge-db.schema.json"
    },
    {
      "fileMatch": [
        "**/config/server/config.*.json",
        "**/source/server/configurable/config.*.json",
        "**/server/configurable/config.*.json"
      ],
      "url": "./.vscode/schemas/config/server.schema.json"
    },
    {
      "fileMatch": [
        "**/contributes/_format.json",
        "**/configurable/_format.json"
      ],
      "url": "./.vscode/schemas/meta/format-meta.schema.json"
    },
    {
      "fileMatch": [
        "**/source/*/manifest.json",
        "**/modules/*/manifest.json",
        "**/.modules/*/manifest.json"
      ],
      "url": "./.vscode/schemas/meta/manifest.schema.json"
    }
  ]
}