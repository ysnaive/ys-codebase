{
  "files.exclude": {
    "**/.git": true,
    "**/.vscode": true,
    "**/.gitignore": true,
    "**/.gitattributes": true,
    "**/.gitkeep": true,
    "LICENSE": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.vscode": true,
    "**/__pycache__": true,
    "**/.cache/**": true,
    "**/build/**": true,
    "**/.mirror/**": true,
    "**/release/**": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/__pycache__/**": true,
    "**/.cache/**": true,
    "**/build/**": true,
    "**/.mirror/**": true,
    "**/.snapshots/**": true,
    "**/release/**": true,
    "plans/archived/**": true,
    "ys_codebase/storage/**": true
  },
  "git.autorefresh": true,
  "git.autoRepositoryDetection": true,
  "git.decorations.enabled": true,
  "git.experimental.useFsWatcher": false,
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  "markdown.preview.openMarkdownLinks": "inPreview",
  "markdown.preview.doubleClickToSwitchToEditor": true
}
