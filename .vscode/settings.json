{
  "files.exclude": {
    "**/.git": true,
    "**/.vscode": true,
    "**/.gitignore": true,
    "**/.gitattributes": true,
    "**/.gitkeep": true,
    "LICENSE": true,
    "**/__pycache__": true,
    "**/.build": true,
    "**/build": true,
    "**/.mirror": true,
    "**/.modules": true,
    "**/modules": true,
    "**/.snapshots": true,
    "**/.venv": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.vscode": true,
    "**/__pycache__": true,
    "**/.cache/**": true,
    "**/.build/**": true,
    "**/build/**": true,
    "**/.mirror/**": true,
    "**/.modules/**": true,
    "**/modules/**": true,
    "**/.snapshots/**": true,
    "**/release/**": true,
    "**/.venv/**": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/__pycache__/**": true,
    "**/.cache/**": true,
    "**/.build/**": true,
    "**/build/**": true,
    "**/.mirror/**": true,
    "**/.modules/**": true,
    "**/modules/**": true,
    "**/.snapshots/**": true,
    "**/release/**": true,
    "plans/archived/**": true,
    "ys_codebase/storage/**": true,
    "**/.venv/**": true
  },
  "git.autorefresh": true,
  "git.autoRepositoryDetection": true,
  "git.decorations.enabled": true,
  "git.experimental.useFsWatcher": false,
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  "markdown.preview.openMarkdownLinks": "inPreview",
  "markdown.preview.doubleClickToSwitchToEditor": true,
  "python.analysis.extraPaths": [
    "./ys_codebase/.venv/py312/lib/python3.12/site-packages"
  ],
  "python.defaultInterpreterPath": "./ys_codebase/.venv/py312/bin/python",
  "_yscb_managed": {
    "description": "Auto-managed by YSCB host bootstrapper. Reversible via module uninstall or rollback.",
    "extraPaths": [
      "./ys_codebase/.venv/py312/lib/python3.12/site-packages"
    ],
    "defaultInterpreterPath": "./ys_codebase/.venv/py312/bin/python",
    "excludes": {
      "files.watcherExclude": "**/.venv/**",
      "search.exclude": "**/.venv/**",
      "files.exclude": "**/.venv"
    }
  }
}
