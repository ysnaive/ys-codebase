{
  "name": "core",
  "version": "1.0.0.0",
  "description": "YS-Codebase Core Infrastructure Module & Package Manager",
  "entry": "scripts/cli.py",
  "dependencies": {},
  "contributes": {
    "core": {
      "uri_schemes": [
        {
          "token": "yscb",
          "type": "const",
          "value": "{yscb_root}",
          "description": "YS-Codebase 工具庫根目錄"
        },
        {
          "token": "yscb.host",
          "type": "const",
          "value": "{yscb_host}",
          "description": "宿主工程根目錄 (包含起手腳本 yscb.py 所在目錄)"
        },
        {
          "token": "module.mirror",
          "type": "const",
          "value": "yscb://.mirror/",
          "description": "本地端模組鏡像庫空間根目錄"
        },
        {
          "token": "snapshot",
          "type": "const",
          "value": "yscb://.snapshots/",
          "description": "組態歷史快照空間目錄"
        },
        {
          "token": "module",
          "type": "const",
          "value": "yscb://modules/",
          "description": "本地模組運行端空間根目錄"
        },
        {
          "token": "config",
          "type": "const",
          "value": "yscb://config/",
          "description": "模組專屬設定檔空間根目錄 (Git 追蹤)"
        },
        {
          "token": "cache",
          "type": "const",
          "value": "yscb://.cache/",
          "description": "模組快取與中繼暫存空間根目錄 (Git 忽略)"
        },
        {
          "token": "storage",
          "type": "const",
          "value": "yscb://storage/",
          "description": "模組持久化儲存空間根目錄 (Git 追蹤)"
        }
      ]
    }
  }
}