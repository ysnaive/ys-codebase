{
  "spaces": {
    "workspace": {
      "description": "母倉工作區專屬排除規則（衍生二層物化區、IDE 與發布目錄）",
      "exclude": [
        ".agents",
        ".vscode",
        ".idea",
        "node_modules",
        "build",
        "dist",
        "target",
        "env",
        "ys_codebase/release"
      ],
      "watch": true
    },
    "gitignore": {
      "description": "母倉發布產物與建置壓縮包忽略規則",
      "entries": ["project://"],
      "include": [
        "ys_codebase/release/**/*.zip",
        "ys_codebase/release/yscb.py",
        "ys_codebase/release/yscb.py.sha256"
      ],
      "watch": false
    },
    "source": {
      "description": "專案業務源碼空間",
      "entries": ["module.source://"],
      "presets": ["workspace", "!gitignore"],
      "exclude": [
        "tests"
      ],
      "include": [
        "*.py",
        "*.ts",
        "*.tsx",
        "*.js",
        "*.jsx",
        "*.go",
        "*.rs",
        "*.java",
        "*.c",
        "*.cpp",
        "*.h",
        "*.hpp",
        "*.cs",
        "*.rb",
        "*.php",
        "*.swift",
        "*.kt"
      ],
      "hash_policy": "adaptive",
      "large_file_threshold_mb": 10,
      "follow_symlinks": false,
      "watch": true
    },
    "cloud": {
      "description": "母倉核心研發資產雲端 1:1 鏡像同步空間",
      "entries": ["project://"],
      "presets": ["workspace", "!gitignore"],
      "exclude": [
        "*.so",
        "*.dll",
        "*.dylib",
        "*.class",
        "*.zip"
      ],
      "include": ["*"],
      "hash_policy": "adaptive",
      "large_file_threshold_mb": 10,
      "follow_symlinks": false,
      "watch": true
    }
  }
}
