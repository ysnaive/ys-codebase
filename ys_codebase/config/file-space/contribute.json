{
  "spaces": {
    "source": {
      "description": "專案業務源碼空間",
      "include": ["module.source://"],
      "exclude": [
        ".git",
        ".venv",
        "__pycache__",
        "node_modules",
        ".agents",
        "build",
        "dist",
        ".pytest_cache",
        "tests"
      ],
      "file_patterns": [
        "*.py",
        "*.ts",
        "*.tsx",
        "*.js",
        "*.jsx",
        "*.go",
        "*.rs",
        "*.java",
        "*.c",
        "*.cpp",
        "*.h",
        "*.hpp",
        "*.cs",
        "*.rb",
        "*.php",
        "*.swift",
        "*.kt"
      ],
      "hash_policy": "adaptive",
      "large_file_threshold_mb": 10,
      "follow_symlinks": false,
      "watch": true
    },
    "cloud": {
      "description": "母倉核心研發資產雲端 1:1 鏡像同步空間",
      "include": ["project://"],
      "exclude": [
        ".git",
        ".agents",
        ".vscode",
        ".idea",
        "__pycache__",
        "node_modules",
        ".pytest_cache",
        "build",
        "dist",
        "target",
        ".venv",
        "venv",
        "env",
        "ys_codebase/.modules",
        "ys_codebase/.build",
        "ys_codebase/.mirror",
        "ys_codebase/.temp",
        "ys_codebase/.snapshots",
        "ys_codebase/.cache",
        "ys_codebase/.config.local",
        "ys_codebase/.storage.local",
        "ys_codebase/.venv",
        "ys_codebase/release",
        "ys_codebase/config/gdrive-support/credentials.json",
        "ys_codebase/config/gdrive-support/token.json",
        "ys_codebase/config/gdrive-support/service_account.json",
        "*secret*.json",
        "*.local.json",
        "*.bak",
        "*.pyc",
        "*.pyo",
        "*.so",
        "*.dll",
        "*.dylib",
        "*.class",
        "*.zip",
        ".DS_Store"
      ],
      "file_patterns": ["*"],
      "hash_policy": "adaptive",
      "large_file_threshold_mb": 10,
      "follow_symlinks": false,
      "watch": true
    }
  }
}
