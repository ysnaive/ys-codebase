{
  "spaces": {
    "source": {
      "description": "專案業務源碼空間",
      "include": ["module.source://"],
      "exclude": [
        ".git",
        ".venv",
        "__pycache__",
        "node_modules",
        ".agents",
        "build",
        "dist",
        ".pytest_cache",
        "tests"
      ],
      "file_patterns": [
        "*.py",
        "*.ts",
        "*.tsx",
        "*.js",
        "*.jsx",
        "*.go",
        "*.rs",
        "*.java",
        "*.c",
        "*.cpp",
        "*.h",
        "*.hpp",
        "*.cs",
        "*.rb",
        "*.php",
        "*.swift",
        "*.kt"
      ],
      "hash_policy": "adaptive",
      "large_file_threshold_mb": 10,
      "follow_symlinks": false,
      "watch": true,
      "weight": 1.0
    }
  }
}
