{
  "uri_schemes": [
    {
      "token": "knowledge.storage",
      "type": "const",
      "value": "cache://knowledge-db/",
      "description": "knowledge-db 模組專屬本機快取存儲空間根目錄"
    }
  ],
  "commands": {
    "module_alias": [],
    "description": "YS-Codebase Knowledge Database & Semantic Retrieval Subsystem",
    "cmd": {
      "status": {
        "description": "查看知識庫空間狀態、指紋快取、同義詞與索引統計",
        "tier": "safe",
        "server_compatible": true,
        "usage": {
          "pros": [
            "日常檢視知識庫已註冊空間與快取狀態"
          ],
          "cons": [
            "執行大量資料庫重構或打包時"
          ]
        }
      },
      "scan": {
        "description": "執行指定空間或全空間聯集增量指紋掃描",
        "tier": "conditional",
        "server_compatible": false,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則掃描全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "all": {
              "description": "掃描全空間",
              "alias": ["a"]
            }
          }
        },
        "usage": {
          "pros": [
            "比對程式碼與文檔變更並更新指紋庫"
          ],
          "cons": [
            "測試期間無需頻繁手動掃描"
          ]
        }
      },
      "bundle": {
        "description": "執行指定空間或全空間聯集之多語言語意打包與導出",
        "tier": "conditional",
        "server_compatible": false,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則打包全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "all": {
              "description": "打包全空間",
              "alias": ["a"]
            }
          }
        },
        "usage": {
          "pros": [
            "建置與發布空間之 SemanticBundle 發布包"
          ],
          "cons": [
            "僅查詢檢索時無需重複完整打包"
          ]
        }
      },
      "index": {
        "description": "建置與快取指定空間或全空間聯集之多欄位倒排索引",
        "tier": "conditional",
        "server_compatible": false,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則索引全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "all": {
              "description": "索引全空間",
              "alias": ["a"]
            }
          },
          "force": {
            "force": {
              "description": "強制重建全量索引與特徵快取",
              "alias": ["f"]
            }
          }
        },
        "usage": {
          "pros": [
            "預熱檢索快取加速大規模檢索"
          ],
          "cons": [
            "檢索 search 指令已內建自動懶索引建置"
          ]
        }
      },
      "search": {
        "description": "對全空間或指定空間符號進行多欄位加權 BM25 語意檢索",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "query": {
            "description": "搜尋關鍵字、符號或描述",
            "required": true
          }
        },
        "options": {
          "display": {
            "preview": {
              "description": "顯示程式碼切片預覽",
              "alias": ["s", "snippet"]
            },
            "detail": {
              "description": "顯示完整詳細資訊",
              "alias": ["d"]
            },
            "simple": {
              "description": "精簡清單輸出 (預設)"
            }
          },
          "format": {
            "json": {
              "description": "以 JSON 格式輸出"
            },
            "md": {
              "description": "以 Markdown 格式輸出"
            }
          },
          "scope": {
            "space": {
              "description": "指定空間名稱 (預設全空間)",
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            },
            "ftype": {
              "description": "篩選檔案類型 (如 md, py)",
              "args": {
                "ext": {
                  "description": "副檔名"
                }
              }
            }
          },
          "limit": {
            "limit": {
              "description": "回傳筆數限制 (auto 或整數)",
              "args": {
                "count": {
                  "description": "筆數"
                }
              }
            }
          },
          "mode": {
            "lexical-only": {
              "description": "僅使用 BM25 詞彙搜尋，略過向量"
            }
          }
        },
        "usage": {
          "pros": [
            "透過關鍵字、符號名稱或功能描述快速定位代碼與文檔 (支援 --snippet 預覽代碼區塊與 Docstring)"
          ],
          "cons": [
            "單純檢視空間清單時請用 status"
          ]
        }
      },
      "callers": {
        "description": "查詢調用指定函式/類別之所有上游調用者 (Callers) 與代碼切片",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "symbol": {
            "description": "目標符號名稱 (如函式或類別名)",
            "required": true
          }
        },
        "options": {
          "display": {
            "preview": {
              "description": "顯示調用點程式碼切片預覽",
              "alias": ["s", "snippet"]
            },
            "detail": {
              "description": "顯示完整詳細資訊",
              "alias": ["d"]
            },
            "simple": {
              "description": "精簡清單輸出"
            }
          },
          "format": {
            "json": {
              "description": "以 JSON 格式輸出"
            },
            "md": {
              "description": "以 Markdown 格式輸出"
            }
          },
          "scope": {
            "space": {
              "description": "限定搜尋空間",
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          }
        },
        "usage": {
          "pros": [
            "排查特定 Public API 或底層方法被哪些上游模組或函式調用 (支援 --snippet 預覽調用點)"
          ],
          "cons": [
            "單純搜尋文檔或關鍵字時請用 search"
          ]
        }
      },
      "callees": {
        "description": "查詢指定函式/類別內部調用了哪些下游方法 (Callees) 與依賴",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "symbol": {
            "description": "目標符號名稱",
            "required": true
          }
        },
        "options": {
          "display": {
            "preview": {
              "description": "顯示程式碼切片預覽",
              "alias": ["s", "snippet"]
            },
            "detail": {
              "description": "顯示完整詳細資訊",
              "alias": ["d"]
            },
            "simple": {
              "description": "精簡清單輸出"
            }
          },
          "format": {
            "json": {
              "description": "以 JSON 格式輸出"
            },
            "md": {
              "description": "以 Markdown 格式輸出"
            }
          },
          "scope": {
            "space": {
              "description": "限定搜尋空間",
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          }
        },
        "usage": {
          "pros": [
            "理解特定函式或類別的內部調用鏈與子組件依賴拓撲"
          ],
          "cons": [
            "單純搜尋文檔或關鍵字時請用 search"
          ]
        }
      },
      "impact": {
        "description": "評估符號變更或重構時向上擴散之多階調用影響面 (Blast Radius)",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "symbol": {
            "description": "目標符號名稱",
            "required": true
          }
        },
        "options": {
          "depth": {
            "depth": {
              "description": "分析擴散階數 (預設: 2)",
              "args": {
                "level": {
                  "description": "層階整數"
                }
              }
            }
          },
          "display": {
            "preview": {
              "description": "顯示調用點程式碼切片預覽",
              "alias": ["s", "snippet"]
            },
            "detail": {
              "description": "顯示完整詳細資訊",
              "alias": ["d"]
            },
            "simple": {
              "description": "精簡清單輸出"
            }
          },
          "format": {
            "json": {
              "description": "以 JSON 格式輸出"
            },
            "md": {
              "description": "以 Markdown 格式輸出"
            }
          },
          "scope": {
            "space": {
              "description": "限定搜尋空間",
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          }
        },
        "usage": {
          "pros": [
            "在修改 Public API 或核心基礎組件前，評估多階層調用擴散半徑 (支援 --depth 控制階數)"
          ],
          "cons": [
            "無關符號重構或單純閱讀單檔代碼時無需調用"
          ]
        }
      },
      "clean": {
        "description": "清理指定空間或全空間之指紋、Bundle 與倒排索引快取",
        "tier": "gated",
        "server_compatible": false,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則清理全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "all": {
              "description": "清理全空間",
              "alias": ["a"]
            }
          }
        },
        "usage": {
          "pros": [
            "快取異常損毀或需要徹底重建資料庫時"
          ],
          "cons": [
            "日常常規操作無需隨意清理快取"
          ]
        }
      }
    }
  }
}
