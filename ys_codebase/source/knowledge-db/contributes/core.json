{
  "uri_schemes": [
    {
      "token": "knowledge.storage",
      "type": "const",
      "value": "storage.local://knowledge-db/",
      "description": "knowledge-db 模組專屬本機持久索引與模型存儲空間根目錄"
    },
    {
      "token": "knowledge.cache",
      "type": "const",
      "value": "cache://knowledge-db/",
      "description": "knowledge-db 模組專屬快取與進程鎖空間根目錄"
    }
  ],
  "commands": {
    "module_alias": [
      "kdb"
    ],
    "description": "YS-Codebase Knowledge Database & Semantic Retrieval Subsystem",
    "cmd": {
      "status": {
        "description": "查看知識庫空間狀態、指紋快取與索引統計",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則顯示全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "all": {
              "description": "顯示全空間狀態",
              "alias": [
                "a"
              ]
            },
            "space": {
              "description": "指定空間名稱",
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          },
          "format": {
            "json": {
              "description": "以 JSON 格式輸出"
            }
          }
        },
        "usage": {
          "pros": [
            "日常檢視知識庫已註冊空間、檢索權重與索引統計狀態"
          ],
          "cons": [
            "執行大量資料庫重構或打包時"
          ]
        }
      },
      "index": {
        "description": "建置與快取指定空間或全空間聯集之多欄位倒排索引",
        "tier": "conditional",
        "server_compatible": true,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則索引全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "all": {
              "description": "索引全空間",
              "alias": [
                "a"
              ]
            }
          },
          "force": {
            "force": {
              "description": "強制重建全量索引與特徵快取",
              "alias": [
                "f"
              ]
            }
          },
          "export": {
            "export": {
              "description": "同時導出語意 Bundle 至指定 JSON 檔案路徑",
              "args": {
                "path": {
                  "description": "導出檔案路徑"
                }
              }
            }
          }
        },
        "usage": {
          "pros": [
            "預熱檢索快取加速大規模檢索",
            "透過 --export 導出語意 Bundle 發布包"
          ],
          "cons": [
            "檢索 search 指令已內建自動懶索引建置"
          ]
        }
      },
      "search": {
        "description": "對全空間或指定空間符號進行多欄位加權 BM25 語意檢索",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "query": {
            "description": "搜尋關鍵字、符號或描述",
            "required": true
          }
        },
        "options": {
          "display": {
            "preview": {
              "description": "顯示程式碼切片預覽",
              "alias": [
                "s",
                "snippet"
              ]
            },
            "detail": {
              "description": "顯示完整詳細資訊",
              "alias": [
                "d"
              ]
            },
            "simple": {
              "description": "極簡清單輸出 (省略分數與同檔單一命中展開)"
            }
          },
          "format": {
            "json": {
              "description": "以 JSON 格式輸出"
            },
            "md": {
              "description": "以 Markdown 格式輸出"
            }
          },
          "scope": {
            "space": {
              "description": "指定空間名稱 (預設全空間)",
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          },
          "filter_ftype": {
            "ftype": {
              "description": "篩選檔案類型 (如 md, py)",
              "args": {
                "ext": {
                  "description": "副檔名"
                }
              }
            }
          },
          "filter_kind": {
            "kind": {
              "description": "篩選符號類型 (如 class, function, method, section)",
              "args": {
                "type": {
                  "description": "符號類型"
                }
              }
            }
          },
          "filter_lang": {
            "lang": {
              "description": "篩選程式語言 (如 python, markdown)",
              "args": {
                "language": {
                  "description": "語言名稱"
                }
              }
            }
          },
          "limit": {
            "limit": {
              "description": "回傳筆數限制 (auto 或整數)",
              "args": {
                "count": {
                  "description": "筆數"
                }
              }
            },
            "max-snippet-lines": {
              "description": "單一符號程式碼切片最大輸出行數 (預設 40 行)",
              "args": {
                "lines": {
                  "description": "最大行數"
                }
              }
            }
          },
          "mode": {
            "lexical-only": {
              "description": "僅使用 BM25 詞彙搜尋，略過向量"
            }
          },
          "uri": {
            "file-uri": {
              "description": "於輸出中附帶完整 file:/// 絕對路徑超連結"
            }
          }
        },
        "usage": {
          "pros": [
            "透過關鍵字、符號名稱或功能描述快速定位代碼與文檔 (支援 --snippet 預覽代碼區塊與 Docstring)"
          ],
          "cons": [
            "單純檢視空間清單時請用 status"
          ]
        }
      },
      "clean": {
        "description": "清理指定空間或全空間之指紋、Bundle 與倒排索引快取",
        "tier": "gated",
        "server_compatible": false,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則清理全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "all": {
              "description": "清理全空間",
              "alias": [
                "a"
              ]
            }
          }
        },
        "usage": {
          "pros": [
            "快取異常損毀或需要徹底重建資料庫時"
          ],
          "cons": [
            "日常常規操作無需隨意清理快取"
          ]
        }
      },
      "model": {
        "description": "管理向量嵌入推論模型（檢視狀態或顯式下載權重）",
        "tier": "safe",
        "server_compatible": true,
        "cmd": {
          "status": {
            "description": "檢視本地向量模型權重快取目錄、檔案狀態與維度",
            "tier": "safe",
            "server_compatible": true,
            "options": {
              "format": {
                "json": {
                  "description": "以 JSON 格式輸出"
                }
              }
            },
            "usage": {
              "pros": [
                "檢視本地向量模型是否已下載就緒"
              ],
              "cons": []
            }
          },
          "download": {
            "description": "顯式下載 FastEmbed 向量模型權重至本地快取",
            "tier": "conditional",
            "server_compatible": true,
            "options": {
              "force": {
                "force": {
                  "description": "強制覆蓋重新下載",
                  "alias": [
                    "f"
                  ]
                }
              }
            },
            "usage": {
              "pros": [
                "在前置部署或離線環境準備時顯式預載模型"
              ],
              "cons": []
            }
          }
        },
        "usage": {
          "pros": [
            "管理向量模型生命週期"
          ],
          "cons": []
        }
      }
    }
  },
  "locales": {
    "definition": "locales/definition.json",
    "zh": "locales/zh.json"
  }
}
