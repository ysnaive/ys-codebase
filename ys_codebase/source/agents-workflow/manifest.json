          "description": "Phase 7 模板主體擴充注入錨點（位於 P07_walkthrough.md 尾部）"
        },
        {
          "value": "FAST_TRACK_HEADER",
          "description": "Fast Track 模板標頭特化擴充注入錨點（位於 fast_track_plan.md）"
        },
        {
          "value": "FAST_TRACK_AGENTS_GUILD",
          "description": "Fast Track JIT 註解內部擴充注入錨點（位於 fast_track_plan.md 頂部）"
        },
        {
          "value": "FAST_TRACK_TEMPLATE",
          "description": "Fast Track 模板主體擴充注入錨點（位於 fast_track_plan.md 尾部）"
        },
        {
          "value": "CHANGELOG_HEADER",
          "description": "變更日誌模板標頭特化擴充注入錨點（位於 changelog.md）"
        },
        {
          "value": "CHANGELOG_AGENTS_GUILD",
          "description": "變更日誌 JIT 註解內部擴充注入錨點（位於 changelog.md 頂部）"
        },
        {
          "value": "CHANGELOG_TEMPLATE",
          "description": "變更日誌模板主體擴充注入錨點（位於 changelog.md 尾部）"
        },
        {
          "value": "UMBRELLA_HEADER",
          "description": "Umbrella 主計畫總覽模板標頭特化擴充注入錨點（位於 umbrella_overview.md）"
        },
        {
          "value": "UMBRELLA_AGENTS_GUILD",
          "description": "Umbrella 主計畫總覽 JIT 註解內部擴充注入錨點（位於 umbrella_overview.md 頂部）"
        },
        {
          "value": "UMBRELLA_TEMPLATE",
          "description": "Umbrella 主計畫總覽模板主體擴充注入錨點（位於 umbrella_overview.md 尾部）"
        },
        {
          "value": "RESEARCH_HEADER",
          "description": "深度調研報告模板標頭特化擴充注入錨點（位於 RXX_research_report.md）"
        },
        {
          "value": "RESEARCH_AGENTS_GUILD",
          "description": "深度調研報告 JIT 註解內部擴充注入錨點（位於 RXX_research_report.md 頂部）"
        },
        {
          "value": "RESEARCH_TEMPLATE",
          "description": "深度調研報告模板主體擴充注入錨點（位於 RXX_research_report.md 尾部）"
        },
        {
          "value": "HANDOFF_HEADER",
          "description": "現場凍結交接模板標頭特化擴充注入錨點（位於 handoff.md）"
        },
        {
          "value": "HANDOFF_AGENTS_GUILD",
          "description": "現場凍結交接 JIT 註解內部擴充注入錨點（位於 handoff.md 頂部）"
        },
        {
          "value": "HANDOFF_TEMPLATE",
          "description": "現場凍結交接模板主體擴充注入錨點（位於 handoff.md 尾部）"
        }
      ],
      "insert": [
        {
          "type": "uri",
          "token": "DEVELOPMENT_STANDARDS",
          "value": "module://agents-workflow/assets/standards/DevelopmentStandards.md",
          "mode": "replace"
        },
        {
          "type": "uri",
          "token": "PHASEXX_HEADER",
          "value": "module://agents-workflow/assets/templates/header.md",
          "mode": "replace"
        },
        {
          "type": "const",
          "token": "BEGIN_HTML_ANNOTATION",
          "value": "<!--",
          "mode": "replace"
        },
        {
          "type": "const",
          "token": "END_HTML_ANNOTATION",
          "value": "-->",
          "mode": "replace"
        },
        {
          "type": "computed",
          "token": "DYNAMIC_CONTEXT_MAP",
          "value": "code.func://agents-workflow/providers:get_dynamic_context_map",
          "mode": "replace"
        }
      ],
      "release_target": [
        {
          "name": "antigravity",
          "description": "Google Antigravity IDE 原生 Slash Commands 與標準規範輸出",
          "projections": {
            "workflow": {
              "target_dir": "project://.agents/workflows",
              "extension": ".md",
              "header": [
                "---",
                "description: {export.description}",
                "---"
              ]
            },
            "template": {
              "target_dir": "project://.agents/templates",
              "extension": ".md"
            },
            "standard": {
              "target_dir": "project://.agents/standards",
              "extension": ".md"
            }
          }
        }
      ]
    }
  }
}