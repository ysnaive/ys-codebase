{
  "name": "agents-workflow",
  "version": "0.1.0",
  "description": "General Agents Workflow Framework with Protocol Artifact Factory and Declarative Injection Engine",
  "entry": "scripts/cli.py",
  "dependencies": {
    "core": ">=1.0.0"
  },
  "contributes": {
    "core": {
      "uri_schemes": [
        {
          "token": "workflow.plans",
          "type": "config",
          "value": "paths.plans",
          "description": "指向 agents-workflow 活躍開發計畫目錄"
        },
        {
          "token": "workflow.archived",
          "type": "config",
          "value": "paths.archived",
          "description": "指向 agents-workflow 歷史封存計畫目錄"
        },
        {
          "token": "workflow.docs",
          "type": "config",
          "value": "paths.docs",
          "description": "指向 agents-workflow 專案知識庫文檔目錄"
        }
      ]
    },
    "agents-workflow": {
      "export": [
        {
          "type": "standard",
          "source": "module://agents-workflow/assets/standards/DocumentationStandards.md",
          "description": "專案文檔標準規範"
        },
        {
          "type": "standard",
          "source": "module://agents-workflow/assets/standards/DevelopmentStandards.md",
          "description": "開發標準規範 SOP 0~7"
        },
        {
          "type": "workflow",
          "source": "module://agents-workflow/assets/workflows/ContextInit.md",
          "description": "上下文熱啟動流程"
        },
        {
          "type": "workflow",
          "source": "module://agents-workflow/assets/workflows/NewPlan.md",
          "description": "標準開發作業流程 (NewPlan) — 定義專案從需求到發布的完整規範與三大分流管控"
        },
        {
          "type": "workflow",
          "source": "module://agents-workflow/assets/workflows/Continue.md",
          "description": "接續中斷或已存在的開發計畫工作流 (Continue) — 支援 handoff.md 現場交接與狀態自動恢復"
        },
        {
          "type": "workflow",
          "source": "module://agents-workflow/assets/workflows/Pause.md",
          "description": "暫停開發與無縫交接工作流 (Pause) — 現場狀態凍結、生成 handoff.md 達成零斷層接手"
        },
        {
          "type": "workflow",
          "source": "module://agents-workflow/assets/workflows/Discuss.md",
          "description": "深度歸因與防淺層修復工作流 (Discuss) — 實作/測試遇阻時的強制暫停、根因追溯與範疇保護機制"
        },
        {
          "type": "workflow",
          "source": "module://agents-workflow/assets/workflows/Review.md",
          "description": "開發完成後品質與細節審查工作流 (Review) — 包含五維度品質矩陣驗收與即時修復閉環"
        },
        {
          "type": "workflow",
          "source": "module://agents-workflow/assets/workflows/Research.md",
          "description": "深度技術調研工作流 (Research) — 適用於高複雜度技術探索、方案選型對比與 R01 專題調研報告產出"
        },
        {
          "type": "workflow",
          "source": "module://agents-workflow/assets/workflows/Idea.md",
          "description": "構想與靈感孵化池工作流 (Idea) — 支援自由發想、What/Why/How/Related 提案產出與一鍵立項流轉"
        },
        {
          "type": "template",
          "source": "module://agents-workflow/assets/templates/P00_semantic_requirements.md",
          "description": "Phase 0 語意需求模板"
        },
        {
          "type": "template",
          "source": "module://agents-workflow/assets/templates/P01_requirements_spec.md",
          "description": "Phase 1 需求規格模板"
        },
        {
          "type": "template",
          "source": "module://agents-workflow/assets/templates/P02_architecture_plan.md",
          "description": "Phase 2 架構設計模板"
        },
        {
          "type": "template",
          "source": "module://agents-workflow/assets/templates/P03_api_spec.md",
          "description": "Phase 3 API規格模板"
        },
        {
          "type": "template",
          "source": "module://agents-workflow/assets/templates/P04_implementation_plan.md",
          "description": "Phase 4 實作計畫模板"
        },
        {
          "type": "template",
          "source": "module://agents-workflow/assets/templates/P05_task.md",
          "description": "Phase 5 任務清單模板"
        },
        {
          "type": "template",
          "source": "module://agents-workflow/assets/templates/P06_test_plan.md",
          "description": "Phase 6 測試計畫模板"
        },
        {
          "type": "template",
          "source": "module://agents-workflow/assets/templates/P07_walkthrough.md",
          "description": "Phase 7 結案報告模板"
        },
        {
          "type": "template",
          "source": "module://agents-workflow/assets/templates/fast_track_plan.md",
          "description": "Fast Track 敏捷計畫模板"
        },
        {
          "type": "template",
          "source": "module://agents-workflow/assets/templates/umbrella_overview.md",
          "description": "Umbrella 主計畫總覽模板"
        },
        {
          "type": "template",
          "source": "module://agents-workflow/assets/templates/changelog.md",
          "description": "計畫變更日誌模板"
        },
        {
          "type": "template",
          "source": "module://agents-workflow/assets/templates/RXX_research_report.md",
          "description": "深度調研報告模板"
        },
        {
          "type": "template",
          "source": "module://agents-workflow/assets/templates/handoff.md",
          "description": "現場凍結交接模板"
        }
      ],
      "token": [
        {
          "value": "PHASEXX_HEADER",
          "description": "P00~P07 模板共通標準標頭注入錨點"
        },
        {
          "value": "DEVELOPMENT_STANDARDS",
          "description": "標準開發作業流程規範主體（來自 DevelopmentStandards.md）"
        },
        {
          "value": "WORKFLOW_NEWPLAN",
          "description": "NewPlan 工作流特化擴充注入錨點（位於 NewPlan.md 尾部）"
        },
        {
          "value": "WORKFLOW_CONTINUE",
          "description": "Continue 工作流特化擴充注入錨點（位於 Continue.md 尾部）"
        },
        {
          "value": "WORKFLOW_PAUSE",
          "description": "Pause 工作流特化擴充注入錨點（位於 Pause.md 尾部）"
        },
        {
          "value": "WORKFLOW_DISCUSS",
          "description": "Discuss 工作流特化擴充注入錨點（位於 Discuss.md 尾部）"
        },
        {
          "value": "WORKFLOW_REVIEW",
          "description": "Review 工作流特化擴充注入錨點（位於 Review.md 尾部）"
        },
        {
          "value": "WORKFLOW_RESEARCH",
          "description": "Research 工作流特化擴充注入錨點（位於 Research.md 尾部）"
        },
        {
          "value": "WORKFLOW_IDEA",
          "description": "Idea 工作流特化擴充注入錨點（位於 Idea.md 尾部）"
        },
        {
          "value": "WORKFLOW_SOP_STANDARDS",
          "description": "專案特化工程規範注入錨點（位於 DevelopmentStandards.md 尾部）"
        },
        {
          "value": "WORKFLOW_DOCS_STANDARDS",
          "description": "專案特化文檔規範注入錨點（位於 DocumentationStandards.md 尾部）"
        },
        {
          "value": "DYNAMIC_CONTEXT_MAP",
          "description": "即時語意 URI 地圖注入錨點（位於 ContextInit.md 頂部）"
        },
        {
          "value": "BEGIN_HTML_ANNOTATION",
          "description": "HTML 註解起始標籤注入錨點"
        },
        {
          "value": "END_HTML_ANNOTATION",
          "description": "HTML 註解結束標籤注入錨點"
        },
        {
          "value": "PHASE00_HEADER",
          "description": "Phase 0 模板標頭特化擴充注入錨點（位於 P00_semantic_requirements.md）"
        },
        {
          "value": "PHASE00_AGENTS_GUILD",
          "description": "Phase 0 JIT 註解內部擴充注入錨點（位於 P00_semantic_requirements.md 頂部）"
        },
        {
          "value": "PHASE00_TEMPLATE",
          "description": "Phase 0 模板主體擴充注入錨點（位於 P00_semantic_requirements.md 尾部）"
        },
        {
          "value": "PHASE01_HEADER",
          "description": "Phase 1 模板標頭特化擴充注入錨點（位於 P01_requirements_spec.md）"
        },
        {
          "value": "PHASE01_AGENTS_GUILD",
          "description": "Phase 1 JIT 註解內部擴充注入錨點（位於 P01_requirements_spec.md 頂部）"
        },
        {
