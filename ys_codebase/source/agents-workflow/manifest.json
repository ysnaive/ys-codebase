          "description": "Phase 4 模板標頭特化擴充注入錨點（位於 P04_implementation_plan.md）"
        },
        {
          "value": "PHASE04_AGENTS_GUILD",
          "description": "Phase 4 JIT 註解內部擴充注入錨點（位於 P04_implementation_plan.md 頂部）"
        },
        {
          "value": "PHASE04_TEMPLATE",
          "description": "Phase 4 模板主體擴充注入錨點（位於 P04_implementation_plan.md 尾部）"
        },
        {
          "value": "PHASE05_HEADER",
          "description": "Phase 5 模板標頭特化擴充注入錨點（位於 P05_task.md）"
        },
        {
          "value": "PHASE05_AGENTS_GUILD",
          "description": "Phase 5 JIT 註解內部擴充注入錨點（位於 P05_task.md 頂部）"
        },
        {
          "value": "PHASE05_TEMPLATE",
          "description": "Phase 5 模板主體擴充注入錨點（位於 P05_task.md 尾部）"
        },
        {
          "value": "PHASE06_HEADER",
          "description": "Phase 6 模板標頭特化擴充注入錨點（位於 P06_test_plan.md）"
        },
        {
          "value": "PHASE06_AGENTS_GUILD",
          "description": "Phase 6 JIT 註解內部擴充注入錨點（位於 P06_test_plan.md 頂部）"
        },
        {
          "value": "PHASE06_TEMPLATE",
          "description": "Phase 6 模板主體擴充注入錨點（位於 P06_test_plan.md 尾部）"
        },
        {
          "value": "PHASE07_HEADER",
          "description": "Phase 7 模板標頭特化擴充注入錨點（位於 P07_walkthrough.md）"
        },
        {
          "value": "PHASE07_AGENTS_GUILD",
          "description": "Phase 7 JIT 註解內部擴充注入錨點（位於 P07_walkthrough.md 頂部）"
        },
        {
