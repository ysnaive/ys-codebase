{
  "uri_schemes": [
    {
      "token": "workflow.plans",
      "type": "config",
      "value": "paths.plans",
      "description": "指向 agents-workflow 活躍開發計畫目錄"
    },
    {
      "token": "workflow.archived",
      "type": "config",
      "value": "paths.archived",
      "description": "指向 agents-workflow 歷史封存計畫目錄"
    },
    {
      "token": "workflow.docs",
      "type": "config",
      "value": "paths.docs",
      "description": "指向 agents-workflow 專案知識庫文檔目錄"
    },
    {
      "token": "workflow.roadmap",
      "type": "config",
      "value": "paths.roadmap",
      "description": "指向 agents-workflow 長期技術路線圖與策略資產目錄"
    }
  ],
  "commands": {
    "module_alias": [],
    "description": "YS-Codebase Multi-Agent Workflow, Standards, Templates & Dev Plans Subsystem",
    "cmd": {
      "plan": {
        "description": "Dev Plans 專案開發計畫管理工具鏈",
        "tier": "safe",
        "server_compatible": true,
        "cmd": {
          "archive": {
            "description": "將已完成之 Dev Plan 安全歸檔至 workflow.archived://",
            "tier": "gated",
            "server_compatible": true,
            "args": {
              "plan_name": {
                "description": "目標計畫目錄名稱",
                "required": true
              }
            },
            "options": {
              "force": {
                "force": {
                  "description": "強制覆蓋歸檔",
                  "alias": ["f"]
                }
              }
            },
            "usage": {
              "pros": [
                "依開發者明確指示封存計畫: plan archive <plan_dir>"
              ],
              "cons": [
                "[!] 嚴禁 Agent 主動或擅自執行 plan archive (除非開發者明確指示歸檔)"
              ]
            }
          },
          "status": {
            "description": "掃描並輸出進行中之 Dev Plans 狀態矩陣，或執行斷點領航與 handoff.md 原子閱後即焚 (--resume)",
            "tier": "safe",
            "server_compatible": true,
            "args": {
              "plan_name": {
                "description": "選填指定目標計畫或 sub_XX 子計畫路徑",
                "required": false
              }
            },
            "options": {
              "target": {
                "plan": {
                  "description": "指定目標計畫或 sub_XX 子計畫路徑",
                  "args": {
                    "val": {
                      "description": "計畫名稱或子路徑"
                    }
                  }
                }
              },
              "resume": {
                "resume": {
                  "description": "輸出確定性下一步領航指令，若存在 handoff.md 則完整印出並立即物理刪除 (Consume & Delete)"
                }
              }
            },
            "usage": {
              "pros": [
                "檢視進行中計畫狀態與階段: plan status",
                "恢復斷點並消費刪除 handoff.md: plan status --resume [--plan <name>]"
              ]
            }
          },
          "search": {
            "description": "搜尋 Dev Plans 內部之決策紀錄 (DR) 或全文關鍵字",
            "tier": "safe",
            "server_compatible": true,
            "args": {
              "query": {
                "description": "搜尋關鍵字",
                "required": false
              }
            },
            "options": {
              "type": {
                "dr": {
                  "description": "僅搜尋 Decision Records (DR)"
                }
              },
              "filter_year": {
                "year": {
                  "description": "依年份過濾 (如 2026)",
                  "args": {
                    "val": {
                      "description": "年份"
                    }
                  }
                }
              },
              "filter_month": {
                "month": {
                  "description": "依月份過濾 (如 08)",
                  "args": {
                    "val": {
                      "description": "月份"
                    }
                  }
                }
              },
              "limit": {
                "limit": {
                  "description": "結果筆數限制 (預設: 20/25)",
                  "args": {
                    "val": {
                      "description": "筆數"
                    }
                  }
                }
              }
            },
            "usage": {
              "pros": [
                "搜尋歷史計畫或決策紀錄: plan search <query>"
              ]
            }
          },
          "check": {
            "description": "合規性診斷 Dev Plans 文件結構、雙檔協同、追溯差集與免讀盲寫追加 changelog.md",
            "tier": "safe",
            "server_compatible": true,
            "args": {
              "plan_name": {
                "description": "指定計畫或 sub_XX 子路徑 (若省略則檢查進行中計畫)",
                "required": false
              }
            },
            "options": {
              "scope": {
                "all": {
                  "description": "包含所有活躍計畫",
                  "alias": ["a"]
                }
              },
              "phase_opt": {
                "phase": {
                  "description": "指定檢核階段 (P00..P07, current, all)",
                  "args": {
                    "val": {
                      "description": "階段代碼"
                    }
                  }
                }
              },
              "log_opt": {
                "log": {
                  "description": "檢核 PASS 時自動以系統時間戳免讀盲寫追加 changelog.md 紀錄 (內文禁含雙引號與反引號)",
                  "args": {
                    "val": {
                      "description": "變更摘要"
                    }
                  }
                }
              },
              "log_type_opt": {
                "type": {
                  "description": "搭配 --log 指定日誌類型 (PHASE | DECISION | REVISION，預設 PHASE)",
                  "args": {
                    "val": {
                      "description": "類型"
                    }
                  }
                }
              },
              "model_opt": {
                "model": {
                  "description": "指定當輪平台宣告之模型名稱",
                  "args": {
                    "val": {
                      "description": "模型名稱"
                    }
                  }
                }
              },
              "format": {
                "json": {
                  "description": "以 JSON 格式輸出診斷報告"
                }
              }
            },
            "usage": {
              "pros": [
                "合規性檢核計畫: plan check [plan_name] [--phase P02] [--log '<摘要>']"
              ]
            }
          },
          "verify": {
            "description": "合規性診斷 Dev Plans、雙檔自癒與免讀盲寫追加 changelog.md (check 之同義指令)",
            "tier": "safe",
            "server_compatible": true,
            "args": {
              "plan_name": {
                "description": "指定計畫或 sub_XX 子路徑 (若省略則檢查進行中計畫)",
                "required": false
              }
            },
            "options": {
              "scope": {
                "all": {
                  "description": "包含所有活躍計畫",
                  "alias": ["a"]
                }
              },
              "phase_opt": {
                "phase": {
                  "description": "指定檢核階段 (P00..P07, current, all)",
                  "args": {
                    "val": {
                      "description": "階段代碼"
                    }
                  }
                }
              },
              "log_opt": {
                "log": {
                  "description": "檢核 PASS 時自動以系統時間戳免讀盲寫追加 changelog.md 紀錄 (內文禁含雙引號與反引號)",
                  "args": {
                    "val": {
                      "description": "變更摘要"
                    }
                  }
                }
              },
              "log_type_opt": {
                "type": {
                  "description": "搭配 --log 指定日誌類型 (PHASE | DECISION | REVISION，預設 PHASE)",
                  "args": {
                    "val": {
                      "description": "類型"
                    }
                  }
                }
              },
              "model_opt": {
                "model": {
                  "description": "指定當輪平台宣告之模型名稱",
                  "args": {
                    "val": {
                      "description": "模型名稱"
                    }
                  }
                }
              },
              "format": {
                "json": {
                  "description": "以 JSON 格式輸出診斷報告"
                }
              }
            },
            "usage": {
              "pros": [
                "合規性檢核計畫並追加日誌: plan verify [plan_name] [--phase P02] [--log '<摘要>' --model '<Model>']"
              ]
            }
          }
        },
        "usage": {
          "pros": [
            "Dev Plans 專案開發計畫管理工具鏈"
          ]
        }
      },
      "release": {
        "description": "執行工作流資產 4-Step 原子發布交易至所有 active release targets",
        "tier": "gated",
        "server_compatible": true,
        "options": {
          "force": {
            "force": {
              "description": "強制完整發布，略過 diff 快取",
              "alias": ["f"]
            }
          }
        },
        "usage": {
          "pros": [
            "模組通過測試後編譯發布工作流資產至各 release_target (如 .agents/)"
          ],
          "cons": [
            "[!] 嚴禁在未獲發布授權前擅自執行"
          ]
        }
      },
      "release-target": {
        "description": "檢視與管理工作流發布目標清冊 (Release Targets)",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "action": {
            "description": "操作動作 (list, add, remove)",
            "required": false,
            "choice": ["list", "add", "remove"]
          },
          "target": {
            "description": "目標名稱 (如 claude, antigravity)",
            "required": false
          }
        },
        "options": {
          "action_opt": {
            "list": {
              "description": "列出發布目標清單",
              "alias": ["l"]
            },
            "add": {
              "description": "新增發布目標",
              "args": {
                "target": {
                  "description": "目標名稱"
                }
              }
            },
            "remove": {
              "description": "移除發布目標",
              "args": {
                "target": {
                  "description": "目標名稱"
                }
              }
            }
          },
          "target_tier": {
            "proj": {
              "description": "作用於專案層級 (config.project.json)",
              "alias": ["project"]
            }
          }
        },
        "usage": {
          "pros": [
            "檢視或管理工作流發布目標清冊: release-target",
            "啟用目標: release-target --add claude --proj (或 add claude --proj)",
            "移除目標: release-target --remove claude --proj (或 remove claude --proj)"
          ]
        }
      },
      "compile": {
        "description": "執行 Stage 1 中繼工廠編譯管線 (展開變數至 cache.root://)",
        "tier": "safe",
        "server_compatible": true,
        "usage": {
          "pros": [
            "測試編譯或除錯 Stage 1 中繼資產: compile"
          ]
        }
      },
      "roadmap": {
        "description": "檢視或管理專案長期技術儲備與策略路線圖 (Roadmaps 列表查詢與 Consume-on-Promote 晉升)",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "action_or_topic": {
            "description": "操作動作 (list, promote) 或指定路線圖主題檔名",
            "required": false
          },
          "topic": {
            "description": "當第一參數為 promote 時指定目標路線圖主題或檔名",
            "required": false
          }
        },
        "options": {
          "display": {
            "list": {
              "description": "列出所有路線圖摘要表格 (自動排除 TODO.md)",
              "alias": ["l"]
            }
          },
          "filter_status": {
            "status": {
              "description": "依路線圖狀態過濾 (Backlog | Proposed | Ready | Deferred)",
              "args": {
                "val": {
                  "description": "狀態值"
                }
              }
            }
          },
          "target_plan": {
            "plan": {
              "description": "搭配 promote 指定既有計畫或 sub_XX 子計畫目錄",
              "args": {
                "val": {
                  "description": "計畫名稱或子路徑"
                }
              }
            }
          },
          "model_opt": {
            "model": {
              "description": "搭配 promote 指定當輪平台宣告之模型名稱",
              "args": {
                "val": {
                  "description": "模型名稱"
                }
              }
            }
          }
        },
        "usage": {
          "pros": [
            "檢視或過濾長期技術儲備: roadmap [--list] [--status Ready]",
            "晉升路線圖至計畫目錄 (Consume-on-Promote): roadmap promote <topic> [--plan <dir>] [--model '<Model>']"
          ]
        }
      },
      "todo": {
        "description": "輕量級待辦與微觀技術債管理工具鏈 (workflow.roadmap://TODO.md 免讀盲寫與打包提取立項)",
        "tier": "safe",
        "server_compatible": true,
        "cmd": {
          "add": {
            "description": "免讀盲寫追加單筆 TODO 條目至 workflow.roadmap://TODO.md (單調遞增編號)",
            "tier": "safe",
            "server_compatible": true,
            "args": {
              "title": {
                "description": "待辦標題 (內文禁含雙引號與反引號)",
                "required": true
              }
            },
            "options": {
              "scope_opt": {
                "scope": {
                  "description": "所屬模組或目標範疇 (預設: general)",
                  "args": {
                    "val": {
                      "description": "模組或檔案範疇"
                    }
                  }
                }
              },
              "note_opt": {
                "note": {
                  "description": "補充備忘與解法要點",
                  "args": {
                    "val": {
                      "description": "備忘字串"
                    }
                  }
                }
              },
              "model_opt": {
                "model": {
                  "description": "指定當輪平台宣告之模型名稱",
                  "args": {
                    "val": {
                      "description": "模型名稱"
                    }
                  }
                }
              }
            },
            "usage": {
              "pros": [
                "單行免讀追加輕量待辦: todo add '<標題>' --scope <範疇> [--note '<備忘>'] [--model '<Model>']"
              ]
            }
          },
          "list": {
            "description": "列出 workflow.roadmap://TODO.md 中之待辦條目",
            "tier": "safe",
            "server_compatible": true,
            "options": {
              "scope_opt": {
                "scope": {
                  "description": "依模組、範疇或關鍵字過濾",
                  "args": {
                    "val": {
                      "description": "關鍵字"
                    }
                  }
                }
              }
            },
            "usage": {
              "pros": [
                "檢視或過濾待辦清單: todo list [--scope <關鍵字>]"
              ]
            }
          },
          "promote": {
            "description": "單筆或多筆打包提取 TODO 條目 (Pop) 並生成 todo.md 與 changelog.md",
            "tier": "conditional",
            "server_compatible": true,
            "args": {
              "todo_ids": {
                "description": "一或多個待辦編號 (如 TODO-01 TODO-03)",
                "required": true
              }
            },
            "options": {
              "slug_opt": {
                "slug": {
                  "description": "新計畫目錄名稱後綴 (snake_case，若未傳入 --plan 則必填)",
                  "args": {
                    "val": {
                      "description": "plan_slug"
                    }
                  }
                }
              },
              "target_plan": {
                "plan": {
                  "description": "選填移入既有計畫或 sub_XX 子計畫目錄",
                  "args": {
                    "val": {
                      "description": "計畫名稱或子路徑"
                    }
                  }
                }
              },
              "model_opt": {
                "model": {
                  "description": "指定當輪平台宣告之模型名稱",
                  "args": {
                    "val": {
                      "description": "模型名稱"
                    }
                  }
                }
              }
            },
            "usage": {
              "pros": [
                "打包提取待辦立項 (Pop & Seed): todo promote TODO-01 [TODO-02...] --slug <plan_slug> [--model '<Model>']"
              ],
              "cons": [
                "[!] 僅限開發者確認將 TODO 條目轉為正式開發計畫時執行"
              ]
            }
          }
        },
        "usage": {
          "pros": [
            "輕量級待辦與微觀技術債管理工具鏈: todo [list|add|promote]"
          ]
        }
      },
      "tokens": {
        "description": "檢視全系統已註冊之 Token 錨點清單與語意 URI 說明",
        "tier": "safe",
        "server_compatible": true,
        "usage": {
          "pros": [
            "檢視全系統可用的 Token 錨點清單: tokens"
          ]
        }
      },
      "session-trace": {
        "description": "執行三級漸進式對話軌跡與五大硬性摩擦訊號提取 (供 /session-audit 調用)",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "plan_name": {
            "description": "選填指定目標計畫或 sub_XX 子計畫路徑",
            "required": false
          }
        },
        "options": {
          "target_plan": {
            "plan": {
              "description": "指定目標計畫或 sub_XX 子計畫路徑",
              "args": {
                "val": {
                  "description": "計畫名稱或子路徑"
                }
              }
            }
          },
          "transcript_opt": {
            "transcript": {
              "description": "顯式指定當前對話之本地 .jsonl 紀錄檔路徑 (優先級 1 定錨)",
              "args": {
                "val": {
                  "description": ".jsonl 檔案路徑"
                }
              }
            }
          },
          "since_opt": {
            "since": {
              "description": "覆寫 Telemetry 擷取時間窗 (最近 N 分鐘)",
              "args": {
                "val": {
                  "description": "分鐘數"
                }
              }
            }
          },
          "limit_opt": {
            "limit": {
              "description": "Telemetry 分析或歷史列表筆數上限 (預設: 50)",
              "args": {
                "val": {
                  "description": "筆數"
                }
              }
            }
          },
          "list_opt": {
            "list": {
              "description": "列出本工作區可抓取之歷史主對話 Session 清單 (自動過濾 Subagent)",
              "alias": ["l"]
            },
            "all": {
              "description": "搭配 --list 列出全機跨工作區與 Subagent 之所有歷史 Session",
              "alias": ["a"]
            }
          },
          "format": {
            "json": {
              "description": "以 JSON 結構化格式輸出完整軌跡與摩擦訊號報告"
            }
          }
        },
        "usage": {
          "pros": [
            "提取當前對話與計畫之隱形摩擦訊號: session-trace [--transcript <path>] [--plan <dir>] [--list [--all]] [--json]"
          ]
        }
      },
      "list": {
        "description": "檢視當前已安裝模組清冊與 agents-workflow 導出規範清單",
        "tier": "safe",
        "server_compatible": true,
        "usage": {
          "pros": [
            "檢視當前環境已安裝之模組清冊與版本"
          ]
        }
      },
      "init": {
        "description": "一鍵初始化工作流目錄結構與 URI 協議",
        "tier": "gated",
        "server_compatible": false,
        "options": {
          "auto": {
            "yes": {
              "description": "自動確認模式",
              "alias": ["y"]
            }
          }
        },
        "usage": {
          "pros": [
            "專案初次建立或重新初始化工作流環境: init"
          ],
          "cons": [
            "[!] 嚴禁在已有工作流配置的環境重複手動執行 init"
          ]
        }
      }
    }
  },
  "locales": {
    "definition": "locales/definition.json",
    "zh": "locales/zh.json",
    "nouns-antigravity": "locales/nouns-antigravity.json",
    "nouns-claude": "locales/nouns-claude.json",
    "nouns-codex": "locales/nouns-codex.json"
