{
  "spaces": {
    "docs": {
      "description": "專案架構與核心知識文檔空間",
      "include": ["workflow.docs://"],
      "exclude": [".git", "archive"],
      "file_patterns": ["*.md", "*.txt", "*.json", "*.yaml", "*.yml"],
      "hash_policy": "adaptive",
      "large_file_threshold_mb": 10,
      "follow_symlinks": false,
      "watch": true
    },
    "plans": {
      "description": "專案演進與開發計畫空間",
      "include": ["workflow.plans://"],
      "exclude": [".git", "archive"],
      "file_patterns": ["*.md"],
      "hash_policy": "adaptive",
      "large_file_threshold_mb": 10,
      "follow_symlinks": false,
      "watch": true
    }
  }
}
