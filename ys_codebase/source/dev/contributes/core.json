{
  "uri_schemes": [
    {
      "token": "module.source",
      "type": "const",
      "value": "yscb://source/",
      "description": "模組源碼空間根目錄"
    },
    {
      "token": "module.build",
      "type": "const",
      "value": "yscb://.build/",
      "description": "本地開發完整建置產物空間根目錄"
    },
    {
      "token": "module.release",
      "type": "const",
      "value": "yscb://release/",
      "description": "模組發布來源空間根目錄"
    }
  ],
  "commands": {
    "module_alias": [],
    "description": "YS-Codebase Module Development, Testing & Release Toolchain",
    "cmd": {
      "create": {
        "description": "Create a new module skeleton (source/<name>)",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "name": {
            "description": "Module name",
            "required": true
          }
        },
        "options": {
          "desc": {
            "desc": {
              "description": "Module description",
              "args": {
                "text": {
                  "description": "Description text"
                }
              }
            }
          }
        },
        "usage": {
          "pros": [
            "建立新模組骨架目錄結構 (source/<name>)"
          ],
          "cons": [
            "[!] 嚴禁未經確認在非源碼目錄或非標準路徑建立模組"
          ]
        }
      },
      "check": {
        "description": "Validate module structure and manifest compliance",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "module": {
            "description": "Module name to check (omit for all modules)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "all": {
              "description": "Check all modules",
              "alias": ["a"]
            }
          },
          "format": {
            "json": {
              "description": "Output in JSON format"
            }
          }
        },
        "usage": {
          "pros": [
            "代碼編寫完成後進行靜態合規與語法預檢 (Phase 5 交付前)"
          ],
          "cons": [
            "[!] 嚴禁未修改代碼即無意義高頻重複執行"
          ]
        }
      },
      "build": {
        "description": "Build dev package (.build.zip with tests)",
        "tier": "conditional",
        "server_compatible": true,
        "args": {
          "module": {
            "description": "Module name to build (omit for all modules)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "all": {
              "description": "Build all modules",
              "alias": ["a"]
            }
          }
        },
        "usage": {
          "pros": [
            "手動打包本地測試包供跨環境測試或本地直裝物化"
          ],
          "cons": [
            "[!] 嚴禁在執行 dev test 前手動執行 dev build (dev test 內部自動前置構建)"
          ]
        }
      },
      "test": {
        "description": "Run module tests inside an isolated sandbox",
        "tier": "safe",
        "server_compatible": false,
        "args": {
          "module": {
            "description": "Module name to test (omit for all modules)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "all": {
              "description": "Test all modules",
              "alias": ["a"]
            }
          },
          "build_mode": {
            "no-build": {
              "description": "Skip pre-building module before test"
            }
          },
          "filter": {
            "k": {
              "description": "Filter tests by expression",
              "alias": ["k"],
              "args": {
                "pattern": {
                  "description": "Pattern expression"
                }
              }
            }
          },
          "verbosity": {
            "quiet": {
              "description": "Quiet mode (suppress verbose logs)",
              "alias": ["q"]
            },
            "verbose": {
              "description": "Verbose mode (show sandbox details)",
              "alias": ["v"]
            }
          }
        },
        "usage": {
          "pros": [
            "正在開發當前模組，需驗證單元邏輯或整體功能 (Phase 5/6)",
            "微調時優先附加 --no-build 或 -k <pattern> 快速跑測"
          ],
          "cons": [
            "[!] 嚴禁在跑測前手動執行 dev build",
            "[!] 嚴禁在日常開發中執行 dev test --all (僅全系統回歸或顯式指示時調用)",
            "[!] 嚴禁在 @build 部署或 release 發布後重複執行 dev test",
            "[!] 嚴禁調用內部原子操作 dev op-test"
          ]
        }
      },
      "release": {
        "description": "Package and release pure module (.zip to release/)",
        "tier": "gated",
        "server_compatible": true,
        "args": {
          "module": {
            "description": "Module name to release (omit for all modules)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "all": {
              "description": "Release all modules",
              "alias": ["a"]
            }
          },
          "force": {
            "force": {
              "description": "Force release without diff check",
              "alias": ["f"]
            }
          }
        },
        "usage": {
          "pros": [
            "模組通過全部測試，正式打包發布 (Phase 7 結案前)"
          ],
          "cons": [
            "[!] 開發者未明確下達發布指示前絕對禁止執行",
            "[!] 發布與安裝完成後已完成品質驗收，無需重複執行 dev test"
          ]
        }
      },
      "release-check": {
        "description": "Run 3-Gate verification on release readiness without packaging",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "module": {
            "description": "Module name to verify",
            "required": true
          }
        },
        "options": {
          "force": {
            "force": {
              "description": "Force check override",
              "alias": ["f"]
            }
          }
        },
        "usage": {
          "pros": [
            "發布前預檢 3-Gate 合規性"
          ]
        }
      },
      "release-git": {
        "description": "Integrated pipeline: test -> release-check -> release -> local git commit/tag",
        "tier": "gated",
        "server_compatible": false,
        "args": {
          "module": {
            "description": "Module name",
            "required": true
          },
          "message": {
            "description": "Git commit message",
            "required": true
          }
        },
        "options": {
          "force": {
            "force": {
              "description": "Force release-git override",
              "alias": ["f"]
            }
          }
        },
        "usage": {
          "pros": [
            "發布完成後進行本地 git commit 與 tag ([!] 嚴禁遠端 push)"
          ],
          "cons": [
            "[!] 未獲指示前絕對禁止擅自執行",
            "[!] 嚴禁執行 git push 遠端同步"
          ]
        }
      },
      "bump-major": {
        "description": "Increment module major version (X.0.0.0)",
        "tier": "gated",
        "server_compatible": true,
        "args": {
          "module": {
            "description": "Module name",
            "required": true
          }
        },
        "usage": {
          "pros": [
            "架構不相容重大升版"
          ],
          "cons": [
            "[!] 未獲指示前絕對禁止擅自執行"
          ]
        }
      },
      "bump-minor": {
        "description": "Increment module minor version (x.Y.0.0)",
        "tier": "gated",
        "server_compatible": true,
        "args": {
          "module": {
            "description": "Module name",
            "required": true
          }
        },
        "usage": {
          "pros": [
            "向下相容新功能升版"
          ],
          "cons": [
            "[!] 未獲指示前絕對禁止擅自執行"
          ]
        }
      },
      "bump-patch": {
        "description": "Increment module patch version (x.y.Z.0)",
        "tier": "gated",
        "server_compatible": true,
        "args": {
          "module": {
            "description": "Module name",
            "required": true
          }
        },
        "usage": {
          "pros": [
            "向下相容 Bug 修復升版"
          ],
          "cons": [
            "[!] 未獲指示前絕對禁止擅自執行"
          ]
        }
      },
      "bump-revision": {
        "description": "Increment module build revision version (x.y.z.R)",
        "tier": "gated",
        "server_compatible": true,
        "args": {
          "module": {
            "description": "Module name",
            "required": true
          }
        },
        "usage": {
          "pros": [
            "工程微調/文檔修訂升版"
          ],
          "cons": [
            "[!] 未獲指示前絕對禁止擅自執行"
          ]
        }
      },
      "op-mksb": {
        "description": "Internal atomic primitive: create isolated virtual test sandbox",
        "tier": "gated",
        "server_compatible": false,
        "args": {
          "module": {
            "description": "Target module name",
            "required": false
          }
        },
        "usage": {
          "cons": [
            "[!] 內部原子操作，嚴禁 Agent 主動手動調用"
          ]
        }
      },
      "op-test": {
        "description": "Internal atomic primitive: run in-place test execution without sandboxing",
        "tier": "gated",
        "server_compatible": false,
        "args": {
          "module": {
            "description": "Target module name",
            "required": false
          }
        },
        "usage": {
          "cons": [
            "[!] 內部原子操作，嚴禁 Agent 主動手動調用"
          ]
        }
      }
    }
  }
}
