{
  "name": "dev",
  "version": "1.0.0.0",
  "description": "YS-Codebase Developer Tools (Scaffold, Checker, Builder, Tester, Releaser)",
  "entry": "scripts/cli.py",
  "dependencies": {
    "core": ">=1.0.0"
  },
  "contributes": {
    "core": {
      "uri_schemes": [
        {
          "token": "module.source",
          "type": "const",
          "value": "yscb://source/",
          "description": "模組源碼空間根目錄"
        },
        {
          "token": "module.build",
          "type": "const",
          "value": "yscb://build/",
          "description": "本地開發完整建置產物空間根目錄"
        },
        {
          "token": "module.release",
          "type": "const",
          "value": "yscb://release/",
          "description": "模組發布來源空間根目錄"
        }
      ]
    }
  }
}