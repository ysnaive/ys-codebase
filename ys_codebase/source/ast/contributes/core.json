          },
          "uri": {
            "file-uri": {
              "description": "於輸出中附帶完整 file:/// 絕對路徑超連結"
            }
          }
        },
        "usage": {
          "pros": [
            "精確追蹤特定方法或重載群組被哪些上游模組調用"
