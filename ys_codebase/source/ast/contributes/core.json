      "slice": {
        "description": "無損提取指定符號之特定源碼部位 (outer / name / signature / parameters / return_type / doc / body)",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "symbol": {
            "description": "目標符號選擇器 (支援 [kind] [scope.]name[(param_types...)] 如 'ASTEngine.slice_part'，或雙冒號規範化 ID '<rel_path>::<fqn>')",
            "required": true
