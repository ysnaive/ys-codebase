{
  "uri_schemes": [
    {
      "token": "ast.storage",
      "type": "const",
      "value": "storage.local://ast/",
      "description": "ast 模組專屬之統一符號快照 (unified.symbols.bin.gz) 與雙向調用圖譜 (unified.graph.bin.gz) 儲存根目錄"
    },
    {
      "token": "ast.cache",
      "type": "const",
      "value": "cache://ast/",
      "description": "ast 模組快取儲存根目錄別名"
    }
  ],
  "events": [
    {
      "on_ast_index_updated": "當 AST 符號快照與雙向呼叫圖譜完成建置或增量熱修補並推進 ast_generation 時觸發"
    },
    {
      "on_register_ast_spaces": "當 ASTEngine 解析預設納管目標空間時觸發，供下游模組（如 knowledge-db）動態注入索引空間"
    }
  ],
  "commands": {
    "module_alias": [],
    "description": "Static AST Outline, Two-Tier Partial Symbol & Bidirectional Call Graph Engine (scripts/cli.py:main)",
    "cmd": {
      "outline": {
        "description": "提取並顯示單一檔案之階層化 AST 符號大綱與跨分部姊妹檔提示 ([Partial Siblings])",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "file": {
            "description": "目標檔案路徑或語意 URI",
            "required": true
          }
        },
        "options": {
          "view": {
            "merged": {
              "description": "針對 partial 型別展開跨分部檔案合併後之完整成員視圖",
              "alias": [
                "m"
              ]
            }
          },
          "visibility": {
            "public": {
              "description": "僅顯示公開 (public) 符號與成員"
            },
            "protected": {
              "description": "僅顯示受保護 (protected) 符號與成員"
            },
            "internal": {
              "description": "僅顯示內部 (internal) 符號與成員"
            },
            "private": {
              "description": "僅顯示私有 (private) 符號與成員"
            },
            "non-private": {
              "description": "顯示所有非私有 (public / protected / internal) 符號與成員",
              "alias": [
                "api"
              ]
            }
          },
          "binding": {
            "static": {
              "description": "僅顯示靜態 (static / @staticmethod / @classmethod) 方法、屬性、欄位或靜態類別"
            },
            "non-static": {
              "description": "僅顯示非靜態 (instance) 成員與型別",
              "alias": [
                "nonstatic",
                "instance"
              ]
            }
          },
          "member_kind": {
            "methods": {
              "description": "僅顯示方法與函式 (method / function)"
            },
            "fields": {
              "description": "僅顯示欄位、屬性與常數/變數 (field / property / variable / constant)"
            },
            "types": {
              "description": "僅顯示型別定義 (class / struct / interface / enum / type_alias)，折疊內部成員"
            }
          },
          "format": {
            "json": {
              "description": "以結構化 JSON 格式輸出"
            }
          },
          "uri": {
            "file-uri": {
              "description": "於輸出中附帶完整 file:/// 絕對路徑超連結"
            }
          }
        },
        "usage": {
          "pros": [
            "在不載入全文索引的情況下極速檢視單檔類別、方法簽名、可見度與行號區間",
            "自動偵測 C# partial 型別並列出同空間其餘分部姊妹檔 ([Partial Siblings])"
          ],
          "cons": [
            "跨空間模糊關鍵字搜尋請使用 knowledge-db search"
          ]
        }
      },
      "callers": {
        "description": "查詢調用指定函式/方法/類別之所有上游調用者 (Callers) 與調用點位置",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "symbol": {
            "description": "目標符號選擇器 (支援 [kind] [scope.]name[(param_types...)])",
            "required": true
          }
        },
        "options": {
          "scope": {
            "space": {
              "description": "限定搜尋工作空間",
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          },
          "filter": {
            "ftype": {
              "description": "篩選檔案副檔名類型 (如 py, cs, cpp, ts, md)",
              "args": {
                "ext": {
                  "description": "副檔名"
                }
              }
            }
          },
          "display": {
            "snippet": {
              "description": "附上調用點上下文程式碼切片預覽",
              "alias": [
                "s",
                "preview"
              ]
            },
            "detail": {
              "description": "顯示完整詳細簽名與調用點資訊",
              "alias": [
                "d"
              ]
            },
            "simple": {
              "description": "精簡清單輸出"
            }
          },
          "format": {
            "json": {
              "description": "以結構化 JSON 格式輸出"
            },
            "md": {
              "description": "以 Markdown 格式輸出"
            }
          },
          "limit": {
            "limit": {
              "description": "回傳筆數限制 (auto 或正整數)",
              "args": {
                "count": {
                  "description": "筆數"
                }
              }
