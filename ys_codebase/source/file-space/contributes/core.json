{
  "uri_schemes": [
    {
      "token": "file-space.storage",
      "type": "const",
      "value": "storage.local://file-space/",
      "description": "[Deprecated] 舊版 file-space 儲存根目錄（新版已收斂至 storage.local://core/space/）"
    },
    {
      "token": "file-space.cache",
      "type": "const",
      "value": "cache://file-space/",
      "description": "[Deprecated] 舊版 file-space 快取根目錄（新版已收斂至 cache://core/space/）"
    }
  ],
  "commands": {
    "module_alias": [],
    "description": "[Deprecated] 轉發至 core.space 之相容指令群（建議更新 core >=1.2.7.5 後執行 python yscb.py remove file-space）",
    "cmd": {
      "status": {
        "description": "[Deprecated] 委派 core.space 顯示各空間配置、head_generation、merkle_root 與消費者游標狀態",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則顯示全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "space": {
              "description": "限定檢視特定工作空間",
              "alias": ["s"],
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          },
          "format": {
            "json": {
              "description": "以結構化 JSON 格式輸出狀態報告"
            }
          }
        }
      },
      "scan": {
        "description": "[Deprecated] 委派 core.space 觸發指定或全空間雙階段增量指紋掃描並更新 YFP2 快照",
        "tier": "conditional",
        "server_compatible": true,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則掃描全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "space": {
              "description": "限定掃描特定工作空間",
              "alias": ["s"],
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          },
          "force": {
            "force": {
              "description": "忽略既有快照強制重新計算全量指紋",
              "alias": ["f"]
            }
          },
          "format": {
            "json": {
              "description": "以結構化 JSON 格式輸出掃描結果"
            }
          }
        }
      },
      "files": {
        "description": "[Deprecated] 委派 core.space 列出指定或全空間受納管之有效檔案清單",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則列舉全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "space": {
              "description": "限定列舉特定工作空間",
              "alias": ["s"],
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          },
          "filter": {
            "pattern": {
              "description": "依萬用字元過濾相對路徑",
              "alias": ["p"],
              "args": {
                "glob": {
                  "description": "Glob 過濾樣式 (如 *.py)"
                }
              }
            }
          },
          "format": {
            "json": {
              "description": "以結構化 JSON 格式輸出檔案清單"
            }
          }
        }
      },
      "diff": {
        "description": "[Deprecated] 委派 core.space 檢視特定消費者游標相對於當前空間快照之待處理增量變更集",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則比較全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "space": {
              "description": "限定比較特定工作空間",
              "alias": ["s"],
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          },
          "consumer": {
            "consumer": {
              "description": "指定消費者游標識別碼 (預設為 default)",
              "alias": ["c"],
              "args": {
                "id": {
                  "description": "消費者 ID"
                }
              }
            }
          },
          "ack": {
            "ack": {
              "description": "檢視差異後同步將該消費者游標推進至最新世代"
            }
          },
          "format": {
            "json": {
              "description": "以結構化 JSON 格式輸出差異明細"
            }
          }
        }
      },
      "clean": {
        "description": "[Deprecated] 委派 core.space 清除指定或全空間之 YFP2 二進位指紋快照與消費者游標狀態",
        "tier": "gated",
        "server_compatible": false,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則清除全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "space": {
              "description": "限定清除特定工作空間之快照",
              "alias": ["s"],
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          },
          "consumer": {
            "consumer": {
              "description": "僅重置指定消費者之游標水位",
              "alias": ["c"],
              "args": {
                "id": {
                  "description": "消費者 ID"
                }
              }
            }
          },
          "format": {
            "json": {
              "description": "以結構化 JSON 格式輸出清理結果"
            }
          }
        }
      }
    }
  }
}
