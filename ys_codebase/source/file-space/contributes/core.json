{
  "uri_schemes": [
    {
      "token": "file-space.storage",
      "type": "const",
      "value": "cache://file-space/",
      "description": "工作空間二進位指紋快照 (YFP2) 與多消費者游標儲存根目錄"
    },
    {
      "token": "file-space.cache",
      "type": "const",
      "value": "cache://file-space/",
      "description": "工作空間快取與快照根目錄別名"
    }
  ],
  "events": [
    {
      "on_file_space_changed": "當受監聽的工作空間發生檔案新增、修改或刪除並完成 YFP2 快照更新時觸發"
    }
  ],
  "commands": {
    "module_alias": [],
    "description": "多工作空間幾何路由、雙階段指紋快照與多消費者變更游標管理指令群",
    "cmd": {
      "status": {
        "description": "顯示各空間幾何配置、檔案數、head_generation、merkle_root 與各消費者游標滯後狀態",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則顯示全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "space": {
              "description": "限定檢視特定工作空間",
              "alias": ["s"],
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          },
          "format": {
            "json": {
              "description": "以結構化 JSON 格式輸出狀態報告"
            }
          }
        },
        "usage": {
          "pros": [
            "檢視已註冊工作空間、世代水位與消費者游標同步狀態"
          ],
          "cons": [
            "不會主動觸發磁碟掃描；若需更新快照請使用 scan"
          ]
        }
      },
      "scan": {
        "description": "觸發指定或全空間雙階段增量指紋掃描，更新 YFP2 二進位快照並回報變更統計",
        "tier": "conditional",
        "server_compatible": true,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則掃描全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "space": {
              "description": "限定掃描特定工作空間",
              "alias": ["s"],
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          },
          "force": {
            "force": {
              "description": "忽略既有快照強制重新計算全量指紋",
              "alias": ["f"]
            }
          },
          "format": {
            "json": {
              "description": "以結構化 JSON 格式輸出掃描結果"
            }
          }
        },
        "usage": {
          "pros": [
            "手動觸發雙階段增量指紋掃描並推進空間世代水位"
          ],
          "cons": [
            "僅檢視既有快照狀態時請使用 status"
          ]
        }
      },
      "files": {
        "description": "列出指定或全空間受納管之有效檔案清單與指紋摘要",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則列舉全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "space": {
              "description": "限定列舉特定工作空間",
              "alias": ["s"],
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          },
          "filter": {
            "pattern": {
              "description": "依萬用字元過濾相對路徑",
              "alias": ["p"],
              "args": {
                "glob": {
                  "description": "Glob 過濾樣式 (如 *.py)"
                }
              }
            }
          },
          "format": {
            "json": {
              "description": "以結構化 JSON 格式輸出檔案清單"
            }
          }
        },
        "usage": {
          "pros": [
            "檢視空間內受納管之檔案清單、大小與內容雜湊"
          ],
          "cons": [
            "進行語意搜尋時請使用 knowledge-db search"
          ]
        }
      },
      "diff": {
        "description": "檢視特定消費者游標相對於當前空間快照之待處理增量變更集",
        "tier": "safe",
        "server_compatible": true,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則比較全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "space": {
              "description": "限定比較特定工作空間",
              "alias": ["s"],
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          },
          "consumer": {
            "consumer": {
              "description": "指定消費者游標識別碼 (預設為 default)",
              "alias": ["c"],
              "args": {
                "id": {
                  "description": "消費者 ID"
                }
              }
            }
          },
          "ack": {
            "ack": {
              "description": "檢視差異後同步將該消費者游標推進至最新世代"
            }
          },
          "format": {
            "json": {
              "description": "以結構化 JSON 格式輸出差異明細"
            }
          }
        },
        "usage": {
          "pros": [
            "查詢特定消費者游標尚未處理之新增、修改與刪除檔案清單"
          ],
          "cons": [
            "預設不會推進游標；若需推進請加 --ack"
          ]
        }
      },
      "clean": {
        "description": "清除指定或全空間之 YFP2 二進位指紋快照與消費者游標狀態",
        "tier": "gated",
        "server_compatible": false,
        "args": {
          "space": {
            "description": "空間名稱 (若省略則清除全空間)",
            "required": false
          }
        },
        "options": {
          "scope": {
            "space": {
              "description": "限定清除特定工作空間之快照",
              "alias": ["s"],
              "args": {
                "name": {
                  "description": "空間名稱"
                }
              }
            }
          },
          "consumer": {
            "consumer": {
              "description": "僅重置指定消費者之游標水位",
              "alias": ["c"],
              "args": {
                "id": {
                  "description": "消費者 ID"
                }
              }
            }
          },
          "format": {
            "json": {
              "description": "以結構化 JSON 格式輸出清理結果"
            }
          }
        },
        "usage": {
          "pros": [
            "重置二進位指紋快照或特定消費者游標水位"
          ],
          "cons": [
            "清理後下次掃描將重新執行全量指紋計算"
          ]
        }
      }
    }
  }
}
