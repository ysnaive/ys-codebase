              "cons": []
            }
          },
          "to-uri": {
            "description": "Convert absolute physical path to semantic URI",
            "tier": "safe",
            "server_compatible": true,
            "args": {
              "path": {
                "description": "Absolute filesystem path to convert",
                "required": true
              }
            },
            "options": {},
            "usage": {
              "pros": [
