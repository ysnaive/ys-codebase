{
  "uri_schemes": [
    {
      "token": "yscb",
      "type": "const",
      "value": "{yscb_root}",
      "description": "YS-Codebase 工具庫根目錄"
    },
    {
      "token": "yscb.host",
      "type": "const",
      "value": "{yscb_host}",
      "description": "宿主工程根目錄 (包含起手腳本 yscb.py 所在目錄)"
    },
    {
      "token": "module.mirror",
      "type": "const",
      "value": "yscb://.mirror/",
      "description": "本地端模組鏡像庫空間根目錄"
    },
    {
      "token": "snapshot",
      "type": "const",
      "value": "yscb://.snapshots/",
      "description": "組態歷史快照空間目錄"
    },
    {
      "token": "module",
      "type": "const",
      "value": "yscb://.modules/",
      "description": "本地模組運行端空間根目錄"
    },
    {
      "token": "config",
      "type": "const",
      "value": "yscb://config/",
      "description": "模組專屬設定檔空間根目錄 (Git 追蹤)"
    },
    {
      "token": "config.local",
      "type": "const",
      "value": "yscb://.config.local/",
      "description": "模組本機私有設定與機密憑證空間根目錄 (Git 忽略、磁碟持久)"
    },
    {
      "token": "cache",
      "type": "const",
      "value": "yscb://.cache/",
      "description": "模組快取與中繼暫存空間根目錄 (Git 忽略)"
    },
    {
      "token": "storage",
      "type": "const",
      "value": "yscb://storage/",
      "description": "模組持久化儲存空間根目錄 (Git 追蹤)"
    },
    {
      "token": "storage.local",
      "type": "const",
      "value": "yscb://.storage.local/",
      "description": "模組本機持久化狀態帳本、模型與索引空間根目錄 (Git 忽略、磁碟持久、免快照)"
    },
    {
      "token": "yscb.venv",
      "type": "const",
      "value": "yscb://.venv/",
      "description": "YSCB 私有微虛擬環境空間根目錄 (Git 忽略)"
    }
  ],
  "commands": {
    "module_alias": [],
    "description": "YS-Codebase Core Microkernel Manager",
    "cmd": {
      "install": {
        "description": "Install one or more modules from provider or local build package (@build)",
        "tier": "gated",
        "server_compatible": false,
        "args": {
          "module": {
            "description": "Module name(s) or specifier(s) (e.g. core@1.0.0 dev@build)",
            "required": true
          }
        },
        "options": {
          "install_mode": {
            "force": {
              "description": "Force reinstall module package",
              "alias": ["f"]
            }
          },
          "security": {
            "ignore-sha256": {
              "description": "Bypass SHA-256 integrity verification (unsafe)",
              "alias": []
            }
          },
          "source": {
            "provider": {
              "description": "Module provider URL or path",
              "alias": ["p"],
              "args": {
                "url": {
                  "description": "Provider URL or path"
                }
              }
            },
            "version": {
              "description": "Module version specifier",
              "alias": ["v"],
              "args": {
                "ver": {
                  "description": "Version string"
                }
              }
            }
          }
        },
        "usage": {
          "pros": [
            "安裝單一或多個新模組能力至環境中",
            "本地模組自引用調試: install <mod...>@build --force (單次批次原子交易)"
          ],
          "cons": [
            "[!] 嚴禁在未授權情況下，於開發過程連動 release 指令自部署，應使用 build + install <mod>@build 部署開發版"
          ]
        }
      },
      "update": {
        "description": "Update installed module(s) to latest version",
        "tier": "gated",
        "server_compatible": false,
        "args": {
          "module": {
            "description": "Module name(s) to update (updates all if omitted)",
            "required": false
          }
        },
        "options": {
          "security": {
            "ignore-sha256": {
              "description": "Bypass SHA-256 integrity verification (unsafe)",
              "alias": []
            }
          },
          "source": {
            "provider": {
              "description": "Module provider URL or path",
              "alias": ["p"],
              "args": {
                "url": {
                  "description": "Provider URL or path"
                }
              }
            }
          }
        },
        "usage": {
          "pros": [
            "升級已安裝之單一、多個或全部模組版本"
          ],
          "cons": [
            "[!] 嚴禁在未獲升級指示前擅自更新"
          ]
        }
      },
      "remove": {
        "description": "Remove one or more installed modules from environment",
        "tier": "gated",
        "server_compatible": false,
        "args": {
          "module": {
            "description": "Module name(s) to remove",
            "required": true
          }
        },
        "options": {
          "remove_mode": {
            "clean": {
              "description": "Clean mirror and cache files",
              "alias": []
            },
            "purge": {
              "description": "Purge storage, storage.local, config, config.local and all module data completely",
              "alias": []
            }
          },
          "flags": {
            "force": {
              "description": "Force removal without prompt",
              "alias": ["f"]
            }
          }
        },
        "usage": {
          "pros": [
            "清理不再使用之單一或多個模組（批次內上下游依賴自動聯集豁免）"
          ],
          "cons": [
            "[!] 嚴禁擅自移除 core 或使用中之依賴模組"
          ]
        }
      },
      "list": {
        "description": "List all installed modules, versions and providers",
        "tier": "safe",
        "server_compatible": true,
        "options": {
          "scope": {
            "remote": {
              "description": "Query remote provider package list",
              "alias": ["r"]
            }
          },
          "filter": {
            "provider": {
              "description": "Filter by provider URL or path",
              "alias": ["p"],
              "args": {
                "url": {
                  "description": "Provider URL or path"
                }
              }
            }
          }
        },
        "usage": {
          "pros": [
            "檢視當前環境已安裝之模組清冊與版本"
          ],
          "cons": []
        }
      },
      "status": {
        "description": "Health check and runtime diagnostic report",
        "tier": "safe",
        "server_compatible": true,
        "options": {},
        "usage": {
          "pros": [
            "環境健康診斷與自我修復檢查"
          ],
          "cons": []
        }
      },
      "reload": {
        "description": "Reconcile and refresh runtime environment",
        "tier": "safe",
        "server_compatible": false,
        "options": {},
        "usage": {
          "pros": [
            "重新聚合 contributes 並觸發模組 on_reload Hook"
          ],
          "cons": []
        }
      },
      "rollback": {
        "description": "Revert environment to the previous snapshot state",
        "tier": "gated",
        "server_compatible": false,
        "args": {
          "snapshot": {
            "description": "Snapshot identifier to rollback to",
            "required": false
          }
        },
        "options": {},
        "usage": {
          "pros": [
            "當前環境損毀時回滾至前一快照"
          ],
          "cons": [
            "[!] 嚴禁未經確認擅自回滾環境"
          ]
        }
      },
      "uri": {
        "description": "Manage and resolve YSCB canonical semantic URIs",
        "tier": "safe",
        "server_compatible": true,
